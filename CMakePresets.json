{
  "version": 10,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "RKE_COMPILE_WARNING_AS_ERROR": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QL_BUILD_EXAMPLES": "OFF",
        "QL_BUILD_TEST_SUITE": "ON",
        "QL_ENABLE_PARALLEL_UNIT_TEST_RUNNER": "OFF"
      },
      "hidden": true
    },
    {
      "name": "debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-tidy",
      "inherits": "debug",
      "cacheVariables": {
        "RKE_USE_CLANG_TIDY": "ON",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "verbose": false,
      "hidden": true
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "inherits": "default"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "inherits": "default"
    },
    {
      "name": "clang-tidy",
      "configurePreset": "clang-tidy",
      "inherits": "default"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "verbosity": "extra",
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^rke_"
        }
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "inherits": "default"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "inherits": "default"
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    }
  ]
}