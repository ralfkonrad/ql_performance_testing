---
# Without this the file replaces the root config and this directory runs no checks
# at all; the exception stays scoped here rather than relaxed at the root.
InheritParentConfig: true
Checks: >
    -bugprone-throwing-static-initialization,
    -cppcoreguidelines-avoid-non-const-global-variables,
...
