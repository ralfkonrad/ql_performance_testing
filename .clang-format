---
Language: Cpp
Standard: c++17


# The following is close to the style we've been using all these years
# without formalizing it.  Formatting won't be enforced, but this file
# can help if you want to use the general feel of the library.


BasedOnStyle: LLVM

IndentWidth: 4
ColumnLimit: 100
NamespaceIndentation: All
MaxEmptyLinesToKeep: 2
FixNamespaceComments: false

BinPackParameters: false
AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: true

DerivePointerAlignment: false
PointerAlignment: Left

# QuantLib headers first, then Boost, then std

SortIncludes: true
IncludeBlocks: Merge
IncludeCategories:
  - Regex: '^"'
    Priority: 1
  - Regex: '^<rke/'
    Priority: 2
  - Regex: '^<ql/'
    Priority: 4
  - Regex: '^<boost/'
    Priority: 5
  - Regex: '^<'
    Priority: 6

AlignEscapedNewlines: Left
BreakBeforeTernaryOperators: false
ConstructorInitializerIndentWidth: 0
SortUsingDeclarations: false
IndentCaseLabels: true
IndentPPDirectives: AfterHash

# const T&, not T const&: clang-tidy's misc-const-correctness inserts the qualifier on
# the right, and FormatStyle above hands its fixes to clang-format, which moves it back.

QualifierAlignment: Left

...
