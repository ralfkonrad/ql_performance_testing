root = true

[CMakeLists.txt]
charset                 = utf-8
indent_size             = 2
insert_final_newline    = true
max_line_length         = 100

[*.{md,yml,cmake}]
charset                 = utf-8
indent_size             = 2
insert_final_newline    = true
max_line_length         = 100
